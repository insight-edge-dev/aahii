generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////// ENUMS ////////////////////

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Category {
  trader
  manufacturer
  authorised_dealer
  service_provider
}

enum EstablishmentType {
  proprietorship
  partnership
  private_ltd
  public_ltd
  trust
  llp
  society
  other
}

enum GstRegistrationType {
  registered
  composite
  unregistered
  exempt
}

enum MsmeType {
  micro
  small
  medium
}

enum MsmeClass {
  trading
  service
  manufacturing
}

enum DocumentType {
  PAN_CARD
  CANCELLED_CHEQUE
  DECLARATION_FORM
  GST_CERTIFICATE
  MSME_CERTIFICATE
  AUTHORIZATION_CERTIFICATE
  TRADE_LICENSE
  ITR_YEAR_1
  ITR_YEAR_2
  PF_REGISTRATION
  ESIC_REGISTRATION
  CLRA_REGISTRATION
}

enum NewsType {
  PRESS
  INTERNAL
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TenderStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum TenderDocumentKind {
  TENDER_DOCUMENT
  CORRIGENDUM
}

enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

//////////////////// ADMIN MODAL ////////////////////

model Admin {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String
  role     AdminRole @default(ADMIN)

  createdAt DateTime @default(now())
}

//////////////////// MAIN VENDOR ////////////////////

model Vendor {
  id         String       @id @default(uuid())
  entityName String
  email      String       @unique
  website    String?
  status     VendorStatus @default(PENDING)
  isDeleted  Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories  VendorCategory[]
  address     VendorAddress?
  taxDetails  VendorTaxDetails?
  business    VendorBusinessDetails?
  applicant   VendorApplicant?
  documents   VendorDocument[]
  adminReview VendorAdminReview?

  @@index([status])
  @@index([isDeleted])
}

//////////////////// CATEGORY ////////////////////

model VendorCategory {
  id       String   @id @default(uuid())
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String
  category Category

  @@unique([vendorId, category])
  @@index([vendorId])
}

//////////////////// ADDRESS ////////////////////

model VendorAddress {
  id       String @id @default(uuid())
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String @unique

  registeredAddress String
  registeredPin     String
  registeredContact String

  sameAsRegistered Boolean @default(false)

  communicationAddress String
  communicationPin     String
  communicationContact String
}

//////////////////// TAX DETAILS ////////////////////

model VendorTaxDetails {
  id       String @id @default(uuid())
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String @unique

  panNumber String
  cinNumber String?

  gstApplicable       Boolean
  gstRegistrationType GstRegistrationType?
  gstNumber           String?

  msmeApplicable Boolean
  msmeNumber     String?
  msmeType       MsmeType?
  msmeClass      MsmeClass?
}

//////////////////// BUSINESS DETAILS ////////////////////

model VendorBusinessDetails {
  id       String @id @default(uuid())
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String @unique

  establishmentType    EstablishmentType
  keyProducts          String[]
  specificProducts     String[]
  hasRelationWithAGIHF Boolean
  relationDetails      String?
}

//////////////////// APPLICANT ////////////////////

model VendorApplicant {
  id       String @id @default(uuid())
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String @unique

  applicantName    String
  authorisedPerson String
}

//////////////////// DOCUMENTS ////////////////////

model VendorDocument {
  id       String @id @default(uuid())
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String

  documentType DocumentType
  fileUrl      String
  publicId     String
  originalName String

  uploadedAt DateTime @default(now())

  @@unique([vendorId, documentType])
  @@index([vendorId])
}

//////////////////// ADMIN REVIEW ////////////////////

model VendorAdminReview {
  id       String @id @default(uuid())
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String @unique

  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
}

//////////////////// NEWS ////////////////////

model News {
  id String @id @default(uuid())

  slug String @unique // ADD THIS

  source String

  category String?

  title String

  excerpt String @db.Text

  content String? @db.Text

  link String?

  coverImage String?

  publicId String?

  featuredImageUrl String?

  featuredImagePublicId String?

  publishedAt DateTime

  featured Boolean @default(false)

  status NewsStatus @default(PUBLISHED)

  type NewsType @default(PRESS)

  isActive Boolean @default(true)

  metaTitle String?

  metaDescription String? @db.Text

  facebookCaption String? @db.Text

  linkedinCaption String? @db.Text

  twitterCaption String? @db.Text

  socialCaption String? @db.Text

  socialHashtags String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([category])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  link        String?
  priority    Boolean  @default(false)
  isActive    Boolean  @default(true)
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([priority])
  @@index([isActive])
}



model Event {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String?  @db.Text
  eventDate     DateTime
  coverImage    String?
  coverPublicId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images EventImage[]

  @@index([eventDate])
}

model EventImage {
  id        String   @id @default(uuid())
  eventId   String
  fileUrl   String
  publicId  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Video {
  id String @id @default(uuid())

  title String

  description String @db.Text

  videoUrl String? // uploaded video url

  videoPublicId String? // cloudinary id

  externalUrl String? // youtube/external

  thumbnail String?

  thumbnailPublicId String?

  publishedAt DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([publishedAt])
}

//////////////////// TENDERS ////////////////////

model Tender {
  id String @id @default(uuid())

  ref String @unique

  title String

  description String @db.Text

  itemType String?

  publicationDate String? @map("bidSubmission")

  preBidMeeting String?

  bidEndDateTime String?

  bidOpeningDateTime String?

  status TenderStatus @default(ACTIVE)

  archived Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  documents TenderDocument[]

  @@index([status])
  @@index([archived])
  @@index([isActive])
  @@index([createdAt])
}

model TenderDocument {
  id String @id @default(uuid())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  tenderId String

  kind TenderDocumentKind @default(TENDER_DOCUMENT)

  title String

  fileUrl String

  publicId String

  originalName String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([tenderId])
  @@index([kind])
}

model Vacancy {
  id                    String        @id @default(cuid())
  title                 String
  slug                  String        @unique
  location              String
  employmentType        String
  department            String
  description           String        @db.Text
  applyEmail            String
  advertisementUrl      String?
  advertisementPublicId String?
  status                VacancyStatus @default(DRAFT)
  postedAt              DateTime
  applicationDeadline   DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
  @@index([postedAt])
  @@index([applicationDeadline])
}
